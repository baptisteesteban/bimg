{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25
    },
    "configurePresets": [
        {
            "name": "debug",
            "displayName": "Debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "ENABLE_TESTS": "ON"
            },
            "binaryDir": "build/Debug"
        },
        {
            "name": "release",
            "displayName": "Release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            },
            "binaryDir": "build/Release"
        },
        {
            "name": "benchmarks",
            "displayName": "Benchmarks",
            "binaryDir": "build/Benchmarks",
            "inherits": "release",
            "cacheVariables": {
                "ENABLE_BENCHMARKS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "displayName": "Debug",
            "configurePreset": "debug",
            "jobs": 8
        },
        {
            "name": "release",
            "displayName": "Release",
            "configurePreset": "release",
            "jobs": 8
        },
        {
            "name": "benchmarks",
            "displayName": "Benchmark",
            "configurePreset": "benchmarks",
            "jobs": 8
        }
    ],
    "testPresets": [
        {
            "name": "debug",
            "displayName": "Debug",
            "configurePreset": "debug"
        }
    ],
    "workflowPresets": [
        {
            "name": "debug",
            "displayName": "Debug",
            "steps": [
                {
                    "type": "configure",
                    "name": "debug"
                },
                {
                    "type": "build",
                    "name": "debug"
                },
                {
                    "type": "test",
                    "name": "debug"
                }
            ]
        }
    ]
}